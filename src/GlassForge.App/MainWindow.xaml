<Window x:Class="GlassForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassForge" Width="1040" Height="700" MinWidth="900" MinHeight="600"
        Background="{StaticResource PageBrush}" WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="GlassForge" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock Text="Frosted glass for any Windows application" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <CheckBox x:Name="StartupCheckBox" Content="Start with Windows" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Click="StartupChanged"/>
        <Button Content="Refresh apps" Click="RefreshApps"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Profiles" FontWeight="SemiBold" FontSize="17" Margin="8"/>
          <ListBox x:Name="ProfilesList" Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" SelectionChanged="ProfileSelected">
            <ListBox.ItemTemplate><DataTemplate>
              <Border Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="12" Margin="2,4">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding ProcessName, StringFormat={}{0}.exe}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                  <Ellipse Grid.Column="1" Width="9" Height="9" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2">
            <TextBlock Text="Running applications" FontWeight="SemiBold" Margin="8,14,8,6"/>
            <ComboBox x:Name="RunningAppsCombo" ItemsSource="{Binding RunningApps}" DisplayMemberPath="Summary" Background="{StaticResource RaisedBrush}" Foreground="{StaticResource TextBrush}" Margin="4" Padding="7"/>
            <Button Content="Add selected application" Click="AddRunningApp"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="26">
        <Grid DataContext="{Binding SelectedProfile}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Glass profile" FontSize="22" FontWeight="SemiBold"/>
          <Grid Grid.Row="1" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Display name" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Process name" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          </Grid>
          <StackPanel Grid.Row="2" Margin="0,26,0,0">
            <Grid><TextBlock Text="Window opacity" FontWeight="SemiBold"/><TextBlock Text="{Binding OpacityLabel}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></Grid>
            <Slider Minimum="100" Maximum="255" Value="{Binding WindowOpacity, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="3" Margin="0,24,0,0">
            <Grid><TextBlock Text="Tint strength" FontWeight="SemiBold"/><TextBlock Text="{Binding TintLabel}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></Grid>
            <Slider Minimum="0" Maximum="255" Value="{Binding TintOpacity, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="4" Margin="0,24,0,0">
            <TextBlock Text="Tint color (hex)" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBox Text="{Binding TintColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Width="180" HorizontalAlignment="Left"/>
            <TextBlock Text="Use 181818 for neutral glass, or add a subtle color that complements your wallpaper." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
          <Border Grid.Row="5" Background="#141419" CornerRadius="8" Padding="14" Margin="0,26,0,0" VerticalAlignment="Top">
            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="GlassForge targets only the selected process. Changes apply when you save and restart the profile. Some protected or elevated applications may require GlassForge to run at the same integrity level."/>
          </Border>
          <Grid Grid.Row="6" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"><CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/><Button Content="Delete" Click="DeleteProfile" Margin="14,4,4,4"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Stop" Click="StopProfile"/><Button Content="Save &amp; apply" Background="{StaticResource AccentBrush}" Click="SaveAndApply"/></StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" Margin="4,14,0,0"/>
  </Grid>
</Window>

