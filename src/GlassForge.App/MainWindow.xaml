<Window x:Class="GlassForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GlassForge" Width="1220" Height="760" MinWidth="1080" MinHeight="660" Background="Transparent" WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource PageBrush}" Margin="0">
    <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="GLASSFORGE" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Desktop materials, refined." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="1,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#50D890" Margin="0,0,7,0"/><TextBlock Text="Live app detection" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,22,0"/><CheckBox x:Name="StartupCheckBox" Content="Start with Windows" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Click="StartupChanged"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="14"/><ColumnDefinition Width="330"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Glass profiles" FontWeight="SemiBold" FontSize="17" Margin="8"/>
          <ListBox x:Name="ProfilesList" Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" SelectionChanged="ProfileSelected"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="12" Margin="2,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ProcessName, StringFormat={}{0}.exe}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Ellipse Grid.Column="1" Width="9" Height="9" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="8,4,8,10"><TextBlock Text="Running applications" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="Updates automatically" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
          <TextBox x:Name="AppSearchBox" Grid.Row="1" Margin="4,0,4,8" TextChanged="AppSearchChanged" ToolTip="Filter by application or process name"/>
          <ListBox Grid.Row="2" ItemsSource="{Binding RunningApps}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="11" Margin="2,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ProcessName, StringFormat={}{0}.exe}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Add" Padding="11,5" Click="AddRunningAppCard"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid>
      </Border>
      <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid DataContext="{Binding SelectedProfile}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Appearance" FontSize="21" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Reset default" Padding="11,5" Margin="0" Click="ResetAppearance"/></Grid>
          <Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Display name" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Process name" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
          <StackPanel Grid.Row="2" Margin="0,22,0,0"><Grid><TextBlock Text="Foreground opacity" FontWeight="SemiBold"/><TextBlock Text="{Binding OpacityLabel}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></Grid><Slider Minimum="100" Maximum="255" Value="{Binding WindowOpacity, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/></StackPanel>
          <StackPanel Grid.Row="3" Margin="0,20,0,0"><Grid><TextBlock Text="Glass color strength" FontWeight="SemiBold"/><TextBlock Text="{Binding TintLabel}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></Grid><Slider Minimum="0" Maximum="255" Value="{Binding TintOpacity, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/></StackPanel>
          <StackPanel Grid.Row="4" Margin="0,22,0,0">
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Glass color" FontWeight="SemiBold"/><TextBlock Text="Choose a preset or create an exact color" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><Border x:Name="ColorPreview" Grid.Column="1" Width="46" Height="46" CornerRadius="9" BorderBrush="White" BorderThickness="1"/></Grid>
            <WrapPanel Margin="0,0,0,10"><Button Width="34" Height="30" Padding="0" Background="#181818" Tag="181818" ToolTip="Neutral" Click="SetTintPreset"/><Button Width="34" Height="30" Padding="0" Background="#19324A" Tag="19324A" ToolTip="Ocean" Click="SetTintPreset"/><Button Width="34" Height="30" Padding="0" Background="#0F594F" Tag="0F594F" ToolTip="Emerald" Click="SetTintPreset"/><Button Width="34" Height="30" Padding="0" Background="#7200B8" Tag="7200B8" ToolTip="Violet" Click="SetTintPreset"/><Button Width="34" Height="30" Padding="0" Background="#A2175B" Tag="A2175B" ToolTip="Rose" Click="SetTintPreset"/><Button Width="34" Height="30" Padding="0" Background="#6B351A" Tag="6B351A" ToolTip="Amber" Click="SetTintPreset"/></WrapPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TintHexBox" Text="{Binding TintColor, UpdateSourceTrigger=PropertyChanged}" TextChanged="TintHexChanged" MaxLength="7"/><Button Grid.Column="2" Content="Choose color…" Click="ChooseTintColor" Margin="0"/></Grid>
          </StackPanel>
          <Grid Grid.Row="5" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="R" Foreground="#FF7777" VerticalAlignment="Center"/><Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="TintChannelChanged"/><TextBlock x:Name="RedValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Text="G" Foreground="#75DC8A" VerticalAlignment="Center"/><Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="TintChannelChanged"/><TextBlock x:Name="GreenValue" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Text="B" Foreground="#7BA8FF" VerticalAlignment="Center"/><Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="TintChannelChanged"/><TextBlock x:Name="BlueValue" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
          <Border Grid.Row="6" Background="#141419" CornerRadius="8" Padding="12" Margin="0,20,0,0"><TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Changes are staged until Save &amp; apply. Stop restores the target window before the host exits."/></Border>
          <Grid Grid.Row="7" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/><Button Content="Delete" Click="DeleteProfile" Margin="14,4,4,4"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Stop" Click="StopProfile"/><Button Content="Save &amp; apply" Background="{StaticResource AccentBrush}" Click="SaveAndApply"/></StackPanel></Grid>
        </Grid></ScrollViewer>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" Margin="4,12,0,0"/>
    </Grid>
  </Grid>
</Window>
