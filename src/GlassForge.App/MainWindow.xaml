<Window x:Class="GlassForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassForge" Icon="Assets/GlassForge.ico" Width="980" Height="700" MinWidth="820" MinHeight="560"
        Background="Transparent" WindowStartupLocation="CenterScreen" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display"
        StateChanged="WindowStateChanged">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="ShowIf" />
    <!-- Editor sections that only apply to one glass mode -->
    <Style x:Key="HostOnly" TargetType="StackPanel">
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Native"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="NativeOnly" TargetType="StackPanel">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Native"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
    </Style>
    <!-- App icons, with the letter tile as the fallback when an app has none -->
    <Style x:Key="AppIcon" TargetType="Image">
      <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
      <Style.Triggers><DataTrigger Binding="{Binding HasIcon}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="LetterTile" TargetType="Border">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Style.Triggers><DataTrigger Binding="{Binding HasIcon}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
    </Style>
    <!-- One option row: title, a single line of explanation, and a switch on the right -->
    <Style x:Key="OptionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="OptionHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,16,0" />
    </Style>
    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{StaticResource BorderBrush}" />
      <Setter Property="Margin" Value="0,22,0,20" />
    </Style>
  </Window.Resources>

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="RootGrid" Background="{StaticResource PageBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
        <Grid Width="18" Height="18" Margin="0,0,10,0">
          <Border CornerRadius="5" Margin="0,0,5,5">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#C4B5FD" Offset="0" /><GradientStop Color="#7C3AED" Offset="1" /></LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border CornerRadius="5" Margin="5,5,0,0" Background="#80FFFFFF" BorderBrush="#C0FFFFFF" BorderThickness="1" />
        </Grid>
        <TextBlock Text="GlassForge" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <Button x:Name="SettingsButton" Grid.Column="1" Style="{StaticResource CaptionButton}" Click="ShowSettings" ToolTip="Settings" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Top">
        <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE713;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Button>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource CaptionButton}" Click="MinimizeClicked" ToolTip="Minimize"><TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE921;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
        <Button Style="{StaticResource CaptionButton}" Click="MaximizeClicked" ToolTip="Maximize"><TextBlock x:Name="MaximizeGlyph" Style="{StaticResource Icon}" FontSize="10" Text="&#xE922;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
        <Button Style="{StaticResource CloseCaptionButton}" Click="CloseClicked" ToolTip="Close to tray"><TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE8BB;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
      </StackPanel>
    </Grid>

    <!-- Settings flyout -->
    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" HorizontalOffset="-180" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="#F21C1B22" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Width="240" Margin="0,4,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="Launch at startup" FontSize="13" VerticalAlignment="Center" />
          <CheckBox x:Name="StartupCheckBox" Grid.Column="1" Click="StartupChanged" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Popup>

    <!-- Workspace -->
    <Grid Grid.Row="1" Margin="10,0,12,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>

      <!-- Apps: the profiles, one row per app -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="10,6,4,8">
          <TextBlock Text="Apps" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
          <Button x:Name="AddAppButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="8,4" Click="ShowAddApp" ToolTip="Add an app">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              <TextBlock Text="Add" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </StackPanel>
          </Button>
        </Grid>
        <ListBox x:Name="ProfilesList" Grid.Row="1" Padding="0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" SelectionChanged="ProfileSelected">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Width="22" Height="22" Margin="0,0,12,0">
                  <Border Style="{StaticResource LetterTile}"><TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <Image Source="{Binding Icon}" Width="22" Height="22" Style="{StaticResource AppIcon}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Glass on or off" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers><DataTrigger Binding="{Binding Profiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="No apps yet" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
          <TextBlock Text="Use Add to give an app glass." Foreground="{StaticResource SubtleBrush}" FontSize="12" TextAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- Add-app picker: running apps that don't have glass yet -->
      <Popup x:Name="AddAppPopup" PlacementTarget="{Binding ElementName=AddAppButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="AddAppOpened">
        <Border Background="#F21C1B22" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8" Width="300" Margin="0,4,0,0">
          <StackPanel>
            <Grid Margin="0,0,0,6">
              <TextBox x:Name="AppSearchBox" Tag="Search running apps" Padding="28,7,8,7" TextChanged="AppSearchChanged" />
              <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" HorizontalAlignment="Left" Margin="11,0,0,0" Foreground="{StaticResource SubtleBrush}" IsHitTestVisible="False" />
            </Grid>
            <ListBox ItemsSource="{Binding RunningApps}" MaxHeight="360" Padding="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Button Click="AddRunningApp" ToolTip="{Binding WindowTitle}" HorizontalContentAlignment="Stretch">
                    <Button.Template>
                      <ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter /></Border></ControlTemplate>
                    </Button.Template>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <Grid Width="20" Height="20" Margin="0,0,10,0">
                        <Border Style="{StaticResource LetterTile}"><TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <Image Source="{Binding Icon}" Width="20" Height="20" Style="{StaticResource AppIcon}" />
                      </Grid>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoRunningAppsText" Text="Every open app already has glass." FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="8,6" Visibility="Collapsed" />
          </StackPanel>
        </Border>
      </Popup>

      <!-- Editor -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <TextBlock Text="Pick an app on the left." Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" DataContext="{Binding SelectedProfile}">
            <ScrollViewer.Style>
              <Style TargetType="ScrollViewer">
                <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
              </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="28,24,22,28">

              <!-- Header -->
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" Margin="0,0,14,0">
                  <Border Style="{StaticResource LetterTile}" CornerRadius="8"><TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <Image Source="{Binding Icon}" Width="32" Height="32" Style="{StaticResource AppIcon}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="Glass on or off" />
              </Grid>

              <!-- Smart diagnosis: looks at the running app (read-only) and recommends a route -->
              <Button x:Name="DiagnoseButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="6,4" Margin="-6,12,0,0" Click="DiagnoseApp" ToolTip="Look at how this app draws and pick the glass that fits (nothing is changed until you apply)">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="12" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock x:Name="DiagnoseLabel" Text="Diagnose this app" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
              </Button>
              <Border x:Name="DiagnosisPanel" Visibility="Collapsed" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,8,0,0">
                <StackPanel>
                  <TextBlock x:Name="DiagnosisFacts" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
                  <TextBlock x:Name="DiagnosisNotes" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                  <TextBlock x:Name="DiagnosisRoute" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                  <TextBlock x:Name="DiagnosisReason" Style="{StaticResource OptionHint}" />
                  <Button x:Name="ApplyRouteButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="14,5" Margin="0,10,0,0" FontSize="12" Click="ApplyRoute" />
                </StackPanel>
              </Border>

              <!-- Mode -->
              <Border Style="{StaticResource SegmentGroup}" Margin="0,26,0,0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="Native" Click="NativeModeChosen" IsChecked="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=Native}" />
                  <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="Overlay" IsChecked="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=Host}" />
                </StackPanel>
              </Border>
              <StackPanel Style="{StaticResource NativeOnly}">
                <TextBlock Text="Windows draws live acrylic on the app's own frame. Sharpest, no overhead." Style="{StaticResource OptionHint}" Margin="0,8,0,0" />
                <TextBlock x:Name="NativeUnsupportedText" Text="Needs Windows 11 22H2 or newer." FontSize="12" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" Visibility="Collapsed" />
              </StackPanel>
              <StackPanel Style="{StaticResource HostOnly}">
                <TextBlock Text="A glass layer behind a see-through app. Works with any app." Style="{StaticResource OptionHint}" Margin="0,8,0,0" />
              </StackPanel>

              <Border Style="{StaticResource Divider}" />

              <!-- Native options -->
              <StackPanel Style="{StaticResource NativeOnly}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Whole window" Style="{StaticResource OptionTitle}" /><TextBlock Text="Glass everywhere the app leaves clear, not just the title bar." Style="{StaticResource OptionHint}" /></StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding ExtendIntoClient}" VerticalAlignment="Center" />
                </Grid>
                <Grid Margin="0,16,0,0" Visibility="{Binding IsNotepad, Converter={StaticResource ShowIf}}">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Solid text area (HDR)" Style="{StaticResource OptionTitle}" /><TextBlock Text="Turn on if HDR is on and your typed text is invisible." Style="{StaticResource OptionHint}" /></StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding SolidTextArea}" VerticalAlignment="Center" />
                </Grid>
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Stay glass when unfocused" Style="{StaticResource OptionTitle}" /><TextBlock Text="Windows normally goes flat when you click away." Style="{StaticResource OptionHint}" /></StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding KeepGlassWhenUnfocused}" VerticalAlignment="Center" />
                </Grid>
                <!-- Apps without their own hook: the experimental Direct3D glass -->
                <StackPanel Margin="0,16,0,0">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Style.Triggers><DataTrigger Binding="{Binding HasHook}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Glass inside the app" Style="{StaticResource OptionTitle}" />
                        <Border Background="#33F87171" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="EXPERIMENTAL" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" /></Border>
                      </StackPanel>
                      <TextBlock Text="For apps that paint every pixel with Direct3D (Qt, Chromium), where Native shows nothing: their background color turns to glass. Tested on LogMeIn Resolve." Style="{StaticResource OptionHint}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding DxgiGlass}" VerticalAlignment="Center" />
                  </Grid>
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top" Margin="0,2,8,0" />
                    <TextBlock Grid.Column="1" Text="Injects code into the app and restarts it when turned on or off (open work and remote sessions in it are closed). Turn on Whole window too." FontSize="12" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,16,0" />
                  </Grid>
                </StackPanel>
              </StackPanel>

              <!-- Overlay options -->
              <StackPanel Style="{StaticResource HostOnly}">
                <Grid>
                  <TextBlock Text="App opacity" Style="{StaticResource OptionTitle}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding OpacityLabel}" FontSize="12" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Slider Minimum="100" Maximum="255" Value="{Binding WindowOpacity}" Margin="0,6,0,0" />
                <Grid Margin="0,16,0,0">
                  <TextBlock Text="Tint strength" Style="{StaticResource OptionTitle}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding TintLabel}" FontSize="12" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Slider Minimum="0" Maximum="255" Value="{Binding TintOpacity}" Margin="0,6,0,0" />
                <TextBlock Text="Tint" Style="{StaticResource OptionTitle}" Margin="0,18,0,8" />
                <WrapPanel Margin="-4,0,0,0">
                  <Button Style="{StaticResource SwatchButton}" Background="#181818" Tag="181818" ToolTip="Neutral" Click="SetTintPreset" />
                  <Button Style="{StaticResource SwatchButton}" Background="#19324A" Tag="19324A" ToolTip="Ocean" Click="SetTintPreset" />
                  <Button Style="{StaticResource SwatchButton}" Background="#0F594F" Tag="0F594F" ToolTip="Emerald" Click="SetTintPreset" />
                  <Button Style="{StaticResource SwatchButton}" Background="#7200B8" Tag="7200B8" ToolTip="Violet" Click="SetTintPreset" />
                  <Button Style="{StaticResource SwatchButton}" Background="#A2175B" Tag="A2175B" ToolTip="Rose" Click="SetTintPreset" />
                  <Button Style="{StaticResource SwatchButton}" Background="#6B351A" Tag="6B351A" ToolTip="Amber" Click="SetTintPreset" />
                  <Button Style="{StaticResource SwatchButton}" Background="{Binding TintHex}" ToolTip="Custom color…" Click="ChooseTintColor">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" FontSize="11" Foreground="#E6FFFFFF" />
                  </Button>
                </WrapPanel>
                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Solid while media plays" Style="{StaticResource OptionTitle}" /><TextBlock Text="So video and the desktop don't mix." Style="{StaticResource OptionHint}" /></StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding PauseWhileMediaPlays}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <!-- Experimental hook, for the apps that have one -->
              <StackPanel Visibility="{Binding HasHook, Converter={StaticResource ShowIf}}">
                <Border Style="{StaticResource Divider}" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Live glass" Style="{StaticResource OptionTitle}" />
                      <Border Background="#33F87171" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="EXPERIMENTAL" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" /></Border>
                    </StackPanel>
                    <TextBlock Text="{Binding HookSummary}" Style="{StaticResource OptionHint}" />
                  </StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding HookGlass}" VerticalAlignment="Center" />
                </Grid>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top" Margin="0,2,8,0" />
                  <TextBlock Grid.Column="1" Text="{Binding HookWarning}" FontSize="12" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,16,0" />
                </Grid>
                <TextBlock x:Name="ExplorerHookMissingText" Text="This build doesn't include the hook (it needs the 64-bit build with the native component)." FontSize="12" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
              </StackPanel>

              <!-- Advanced -->
              <Border Style="{StaticResource Divider}" />
              <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="6,4" Margin="-6,0,0,0" Click="ToggleAdvanced">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Advanced" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <TextBlock x:Name="AdvancedChevron" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Margin="8,1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
              </Button>
              <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Corners" Style="{StaticResource OptionTitle}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Style="{StaticResource Segment}" GroupName="Corners" Content="Default" IsChecked="{Binding Corners, Converter={StaticResource EnumMatch}, ConverterParameter=Default}" />
                      <RadioButton Style="{StaticResource Segment}" GroupName="Corners" Content="Round" IsChecked="{Binding Corners, Converter={StaticResource EnumMatch}, ConverterParameter=Round}" />
                      <RadioButton Style="{StaticResource Segment}" GroupName="Corners" Content="Small" IsChecked="{Binding Corners, Converter={StaticResource EnumMatch}, ConverterParameter=RoundSmall}" />
                      <RadioButton Style="{StaticResource Segment}" GroupName="Corners" Content="Square" IsChecked="{Binding Corners, Converter={StaticResource EnumMatch}, ConverterParameter=Square}" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Title bar" Style="{StaticResource OptionTitle}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Style="{StaticResource Segment}" GroupName="TitleBar" Content="Default" IsChecked="{Binding TitleBar, Converter={StaticResource EnumMatch}, ConverterParameter=Default}" />
                      <RadioButton Style="{StaticResource Segment}" GroupName="TitleBar" Content="Dark" IsChecked="{Binding TitleBar, Converter={StaticResource EnumMatch}, ConverterParameter=Dark}" />
                      <RadioButton Style="{StaticResource Segment}" GroupName="TitleBar" Content="Light" IsChecked="{Binding TitleBar, Converter={StaticResource EnumMatch}, ConverterParameter=Light}" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Process name" Style="{StaticResource OptionTitle}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. olk" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="-6,16,0,0">
                  <Button Style="{StaticResource GhostButton}" Padding="6,4" Click="ResetAppearance" Content="Reset to default" FontSize="12" />
                  <Button Style="{StaticResource DangerButton}" Padding="6,4" Margin="8,0,0,0" Click="DeleteProfile" Content="Remove app" FontSize="12" ToolTip="Remove this app and restore its window" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
