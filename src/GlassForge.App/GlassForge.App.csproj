<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>GlassForge</AssemblyName>
    <RootNamespace>GlassForge</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.1.4</Version>
    <ApplicationIcon>Assets\GlassForge.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GlassForge.Tests" />
    <Resource Include="Assets\GlassForge.ico" />
  </ItemGroup>
  <!-- Full File Explorer glass: the native hook (native/, built with CMake) ships inside the exe. Without a native
       build the option stays unavailable rather than failing the app build. -->
  <ItemGroup Condition="Exists('..\..\native\build\Release\GlassForge.Hook.dll')">
    <EmbeddedResource Include="..\..\native\build\Release\GlassForge.Hook.dll" LogicalName="GlassForge.Hook.dll" Link="Assets\GlassForge.Hook.dll" />
  </ItemGroup>
</Project>
